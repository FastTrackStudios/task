# Task runtime env. Copy to `.env` (gitignored) and fill in what you
# need — nothing here is required for a local dev boot.
#
# This file is a COMPLETE inventory of every variable read by
# `apps/task/server/src/**` and `apps/task/cli/src/**`, plus the two
# read from crates outside them that matter operationally:
# `TASK_DATA_ROOT` (`features/task/org/org-proto/src/root.rs`) and
# `TASK_VOX_URL_WEB` (`crates/task/ui/src/vox_session.rs`).
#
# `task-server` does NOT load `.env` itself — it reads the process
# environment. `dx serve` does export `.env` during the wasm build,
# which is how `TASK_VOX_URL_WEB` gets baked in.
#
# ── Duplicated key pairs (read explicitly) ─────────────────────────
# Some settings accept a `TASK_`-prefixed name AND a bare vendor name.
# The `TASK_` form is checked FIRST and wins; the bare form is a
# fallback so a shell already configured for the vendor tool works:
#
#   TASK_ESV_API_KEY       → ESV_API_KEY
#   TASK_API_BIBLE_KEY     → API_BIBLE_KEY
#   TASK_FORGEJO_TOKEN     → FORGEJO_TOKEN
#   TASK_FORGEJO_BOT_TOKEN → FTS_CODEBERG_ACCESS_TOKEN
#   TASK_GITHUB_TOKEN      → GITHUB_TOKEN → ~/.config/task/github-token
#   TASK_FFMPEG / FTS_FFMPEG are separate lookups in different code
#   paths, not a fallback pair.
#
# Collapsing these is a code change, not a docs change — until then
# set only one per pair to avoid surprises.


# ════════════════════════════════════════════════════════════════════
#  SERVER — apps/task/server
# ════════════════════════════════════════════════════════════════════

# ── Process + data root ────────────────────────────────────────────

# Listen address. Default 0.0.0.0:9090.
TASK_SERVER_BIND=127.0.0.1:18080

# Org slug to serve. Unset = single-org auto-pick, or auto-bootstrap
# an org named `default`.
TASK_SERVER_ORG=

# Root of the per-org data tree: `$TASK_DATA_ROOT/orgs/<slug>/` holds
# each org's vault, sqlite databases, and crdt dir. Default `$HOME/.task`.
# Read by server AND CLI. Point at a throwaway dir for a clean slate.
TASK_DATA_ROOT=

# Public base URL the server advertises (share links, callbacks).
TASK_SERVER_PUBLIC_URL=

# Directory holding a built `dx` web bundle (index.html + wasm/ +
# assets/). When set, the SPA is served same-origin next to /vox.
TASK_SERVER_WEB_DIR=

# ── Per-org path overrides (default: under the org's data dir) ──────

# Markdown vault root — source of truth for note-backed entities.
TASK_SERVER_VAULT_ROOT=
# Per-file Loro doc persistence (collaborative vault text editing).
TASK_SERVER_CRDT_ROOT=
# Wiki pages root.
TASK_SERVER_WIKI_ROOT=
# Maildir root for the email slice.
TASK_SERVER_MAIL_ROOT=
# Path to the collections store file. Missing file = empty store.
TASK_SERVER_COLLECTIONS_PATH=

# ── Per-service sea-orm database URLs (default: org-local sqlite) ───

TASK_SERVER_AGENT_TASKS_URL=
TASK_SERVER_TIMER_URL=
TASK_SERVER_THREADS_URL=
TASK_SERVER_NOTIFY_URL=
TASK_SERVER_PREFS_URL=
TASK_SERVER_FINANCE_URL=

# ── Auth / authorization ───────────────────────────────────────────

# Signing secret for architect-auth sessions. Unset falls back to a
# dev key — fine locally, never in production.
TASK_AUTH_SECRET=

# Set to exactly `1` to turn on the architect permissions gate.
# Anything else (or unset) leaves enforcement off: the gate still
# evaluates every call and logs what it WOULD have refused, but refuses
# nothing. Read those logs (or `GET /server/permissions`) before setting
# this —.
TASK_ENFORCE_PERMISSIONS=

# Comma-separated list of browser origins allowed to call this server,
# e.g. `https://task.example,https://app.example`. UNSET (or `*`) keeps
# the historical behaviour — CORS wide open to every origin — and logs a
# WARN at startup saying so. Set it on anything internet-reachable.
TASK_CORS_ALLOWED_ORIGINS=

# ── Bearer tokens for the non-vox HTTP surfaces ────────────────────

# Static bearer for the MCP endpoint (`POST /org/{slug}/mcp`).
# Unset/empty = the route rejects every request.
TASK_MCP_TOKEN=

# Bearer for the watchOS HTTP bridge (`/watch/v1/*`).
TASK_WATCH_TOKEN=

# Bearer guarding the snapshot / git-backup routes. Also read by the
# CLI when it pushes a backup, and by `GET /server/permissions` (the
# permissions-enforcement dry-run). Unset = all three routes are 503.
TASK_BACKUP_GIT_TOKEN=

# ── Notifications ──────────────────────────────────────────────────

# Push channel for the notifier: a webhook URL that receives one JSON
# POST per notification (ntfy-style fields — `title`, `message`,
# `click` — plus `kind`, `org`, `actor`, `created_at`). Point it at an
# ntfy topic proxy, an iOS Shortcuts webhook, or anything accepting
# JSON. Fire-and-forget with a 3s timeout; failures are logged, never
# blocking. Unset/empty = channel off (in-app notifications still
# work — the bell is fed by the per-org store + stream).
TASK_NOTIFY_WEBHOOK=

# ── Share links ────────────────────────────────────────────────────

# Base URL minted into public share links. Falls back to
# TASK_SERVER_PUBLIC_URL, then to TASK_SERVER_BIND.
TASK_SHARE_PUBLIC_BASE=
# Origin of the app a share link should deep-link back into.
TASK_SHARE_APP_ORIGIN=

# ── Forge sync (Forgejo / Codeberg) ────────────────────────────────

# Forge base URL, e.g. https://codeberg.org
TASK_FORGEJO_BASE_URL=
# Human/owner token. Fallback: FORGEJO_TOKEN.
TASK_FORGEJO_TOKEN=
FORGEJO_TOKEN=
# Bot-identity token so agent forge actions are attributable.
# Fallback: FTS_CODEBERG_ACCESS_TOKEN.
TASK_FORGEJO_BOT_TOKEN=
FTS_CODEBERG_ACCESS_TOKEN=
# Poll interval (seconds) for the server-side forge sync loop.
TASK_FORGE_POLL_SECS=

# ── Scripture providers ────────────────────────────────────────────

# ESV API key. Fallback: ESV_API_KEY.
TASK_ESV_API_KEY=
ESV_API_KEY=
# api.bible key. Fallback: API_BIBLE_KEY.
TASK_API_BIBLE_KEY=
API_BIBLE_KEY=
# api.bible NIV bible id (no bare fallback).
TASK_API_BIBLE_NIV_ID=

# ── Reporting ──────────────────────────────────────────────────────

# Build revision reported by the server's version endpoint. Normally
# injected by CI, not by hand. Unset reports "unknown".
TASK_BUILD_REV=


# ════════════════════════════════════════════════════════════════════
#  CLI — apps/task/cli (the `task` binary)
# ════════════════════════════════════════════════════════════════════

# ── Connection + session ───────────────────────────────────────────

# vox URL the CLI (and the native desktop app) connects to. Also a
# clap flag: `--vox-url`. Empty = offline; no sync attempted.
TASK_VOX_URL=ws://127.0.0.1:18080/vox

# vox URL for the server-admin command group. Derived when unset.
TASK_SERVER_VOX_URL=

# Session bearer token (clap flag `--session-token`).
TASK_SESSION_TOKEN=

# Active organization id (clap flag `--organization-id`).
TASK_ORGANIZATION_ID=

# Path to the persisted CLI session file. Default under
# `$XDG_DATA_HOME` (or `$HOME/.local/share`).
TASK_SESSION_FILE=

# `1` / `true` / `yes` runs services in-process instead of talking to
# a running task-server. Local-only flows (timer, finance) use this.
TASK_EMBED=

# ── Local overrides for local-only commands ────────────────────────

# Vault dir override for `task plan` and friends.
TASK_VAULT_ROOT=
# Explicit org / user UUID when there is no auth row to resolve.
TASK_ORG_ID=
TASK_USER_ID=
# sqlite URL for the local timer/finance database (test fixtures point
# this at a throwaway file).
TASK_TIMER_DB=

# ── Invoicing (`task finance invoice …`) ───────────────────────────

# `id=Name,id=Name` map used to label members with no auth row.
TASK_MEMBER_NAMES=

# Issuer ("From") block. `<org>/issuer.toml` is the durable source;
# these override per field, mainly for fixtures.
TASK_ISSUER_NAME=
TASK_ISSUER_ADDRESS=
TASK_ISSUER_EMAIL=
TASK_ISSUER_PHONE=
TASK_ISSUER_TAX_ID=

# Path to the PDF renderer binary (task-pdf-render lives in a
# quarantined workspace, so it is invoked rather than linked).
TASK_PDF_RENDER_BIN=

# ── Agent / goal loop (`task goal …`) ──────────────────────────────

# Shell command that runs one worker iteration.
TASK_AGENT_CMD=
# Shell command that evaluates whether the goal condition is met.
TASK_GOAL_EVAL_CMD=
#
# NOT settings: `TASK_GOAL` and `TASK_GOAL_ITER` are EXPORTED BY the
# CLI into the worker subprocess. Setting them here does nothing.

# ── Forge / git (CLI side) ─────────────────────────────────────────

# GitHub PAT. Order: TASK_GITHUB_TOKEN → GITHUB_TOKEN →
# ~/.config/task/github-token.
TASK_GITHUB_TOKEN=
GITHUB_TOKEN=
#
# The CLI reads the same TASK_FORGEJO_BASE_URL / TASK_FORGEJO_TOKEN /
# FORGEJO_TOKEN / TASK_BACKUP_GIT_TOKEN documented in the server
# section above.

# ── External tools shelled out to by ingest commands ───────────────

TASK_YTDLP=yt-dlp
TASK_PDFTOTEXT=pdftotext
TASK_FFMPEG=ffmpeg
TASK_WHISPER_MODEL=small
# FTS-prefixed media tool overrides (a separate lookup from TASK_FFMPEG).
FTS_FFMPEG=
FTS_FFPROBE=

# ── Third-party API credentials ────────────────────────────────────

# Groq — hosted transcription / completions.
GROQ_API_KEY=
# Podcast Index — podcast search + ingest.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Readwise — highlight import (clap flag `--token`).
READWISE_TOKEN=
# Karakeep — bookmark import (clap flags `--endpoint` / `--token`).
KARAKEEP_ENDPOINT=
KARAKEEP_TOKEN=

# ── Standard environment the CLI reads ─────────────────────────────
#
# HOME, USER, HOST, HOSTNAME, XDG_DATA_HOME — default paths and the
# machine identity stamped on records. Your shell sets these; do not
# set them here.


# ════════════════════════════════════════════════════════════════════
#  WEB / UI — build-time only
# ════════════════════════════════════════════════════════════════════

# `task-app-web` is wasm and cannot read process env at runtime, so
# this is baked in at COMPILE time via
# `option_env!("TASK_VOX_URL_WEB")` in
# `crates/task/ui/src/vox_session.rs`. `dx serve` exports `.env`
# during the wasm build, so setting it here is enough for local dev;
# CI/production passes it as a build-time env var.
#
# Local dev: match TASK_SERVER_BIND above.
# Production: the public reverse-proxy URL (wss://task.example.com/vox).
TASK_VOX_URL_WEB=ws://127.0.0.1:18080/vox

# ── `just live` — the local web app against a deployed server ─────────
#
# UI iteration against real data: `dx serve` on :8766 with the vox URL
# pointed at TASK_LIVE_SERVER and the account below baked in as the
# debug demo cast (`TASK_DEMO_CAST`, `crates/ui/src/auth.rs`), so the
# page boots signed in. The sign-in form posts to the server's ISSUER
# when it advertises one (`central_auth`), so this is the issuer
# password, not the org store's. Media proxies stay on the local server
# (apps/web/Dioxus.toml is committed against :18080), so song playback
# is the one thing that does not follow the live server.
TASK_LIVE_SERVER=https://task.example.com
TASK_LIVE_EMAIL=you@example.com
TASK_LIVE_PASSWORD=
TASK_LIVE_NAME=You
