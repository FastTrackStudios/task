#!/usr/bin/env bash
set -euo pipefail

# Pre-push: run local CI (scripts/ci-local.sh: fmt, change files, and the
# clippy / tests / wasm that `cargo rail plan` says the change affects) on
# this machine's warm target dir, and once the push lands mark every
# pushed commit with the `local-ci` status. That status is a required
# check on main: PRs run only the free hosted checks, so this is where
# clippy and the tests gate a PR (checks.yml header).
#
# It checks the CHECKED-OUT tree, so it vouches only for pushed commits
# that tree contains: HEAD and its ancestors, i.e. the layers of a stack
# pushed from its top (`gh stack submit` from the top branch). A pushed
# branch HEAD doesn't contain, or a dirty tree, gets no status; push it
# from its own checkout, or run the full set on GitHub instead:
#
#   gh workflow run checks.yml --ref <branch>     (posts local-ci when green)
#
# Skip switch: `NO_LOCAL_CI=1 git push …` (or the old `NO_CAPN=1`) pushes
# without checking. The PR then waits on `local-ci` until a checked push or
# a dispatched run marks it.
#
# Pushes queue on one lock per clone, so parallel agents don't each build
# the workspace at once (the build machine's free-memory watchdog).

if [ "${NO_LOCAL_CI:-${NO_CAPN:-0}}" = "1" ]; then
  echo >&2 "pre-push: NO_LOCAL_CI=1, not checked; the PR's local-ci check stays pending."
  exit 0
fi

zero="0000000000000000000000000000000000000000"
head="$(git rev-parse HEAD)"
covered=()
uncovered=()
while read -r _lref lsha rref _rsha; do
  [ "$lsha" = "$zero" ] && continue # a branch delete
  case "$rref" in refs/heads/*) ;; *) continue ;; esac # tags
  if git merge-base --is-ancestor "$lsha" "$head" 2>/dev/null; then
    covered+=("$lsha")
  else
    uncovered+=("${rref#refs/heads/}")
  fi
done

if [ "${#uncovered[@]}" -gt 0 ]; then
  echo >&2 "pre-push: not in the checked-out tree, so no local-ci for: ${uncovered[*]}"
fi
[ "${#covered[@]}" -gt 0 ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo >&2 "pre-push: uncommitted changes, so a green run would not prove the pushed commits."
  echo >&2 "          Pushing without local-ci; commit them and push again to get it."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMON_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)"

if command -v flock >/dev/null 2>&1; then
  exec 9>"$COMMON_DIR/ci-local.lock"
  flock -n 9 || { echo >&2 "pre-push: another push's local CI is running; waiting…"; flock 9; }
fi

# ci-local needs the dev shell (cargo-rail, nextest, the desktop stack's
# system libs). If `pkg-config` already sees pango + libsoup we are in
# this repo's shell; otherwise re-enter it, even when IN_NIX_SHELL is set
# (that may be some other project's shell).
in_shell=0
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists pango libsoup-3.0 2>/dev/null; then
  in_shell=1
fi
if [ "$in_shell" = 1 ] || ! command -v nix >/dev/null 2>&1; then
  bash "$REPO_ROOT/scripts/ci-local.sh"
else
  nix develop "$REPO_ROOT" -c bash "$REPO_ROOT/scripts/ci-local.sh"
fi

log="$COMMON_DIR/ci-local.log"
nohup bash "$REPO_ROOT/scripts/ci-local.sh" --post "${covered[@]}" >>"$log" 2>&1 </dev/null &
echo >&2 "pre-push: green; local-ci goes to ${#covered[@]} commit(s) once GitHub has them (log: $log)"
