#!/bin/sh
# build-lease — a counting Rust build lease per host (POSIX sh; Linux + macOS).
#
#   build-lease acquire [--slots N] <owner> [ttl_seconds]  # exit 0 = you hold a slot, 1 = all slots busy
#   build-lease renew   <owner> [ttl_seconds]
#   build-lease release <owner>
#   build-lease status
#   build-lease slots [N]                                   # show / set the host's slot count
#
# N slots, each a directory created with mkdir (atomic on one filesystem),
# so no two owners can hold the same slot and at most N builds run at once.
# Slot 0 is the historical single lease path, so with N=1 (the default)
# this behaves exactly like the old exclusive lease. A slot expires after
# ttl (default 4h) unless renewed, so a crashed worker cannot wedge the
# host forever. One owner holds at most one slot; acquiring again renews it.
#
# N is host policy, not per-caller: it lives in "$L.slots" (set it with
# `build-lease slots N`). `--slots N` overrides it for one call only —
# for experiments; agents should not pass it.
#
# Slots bound CPU/RAM. They do not make two builds in ONE target dir run
# together: cargo serialises those on the target's own lock. Concurrent
# builds need separate target dirs (`wt-new` seeds one by reflink).
#
# Override the location with BUILD_LEASE_DIR.
set -eu

if [ -n "${BUILD_LEASE_DIR:-}" ]; then L="$BUILD_LEASE_DIR"
elif [ -d /run/media/Development ]; then L=/run/media/Development/.build-lease      # THEBATTLESHIP dev drive
elif [ -d /Volumes/build-disk/development ]; then L=/Volumes/build-disk/development/.build-lease  # airlock external SSD (volume root is root-owned)
else L="${HOME}/.build-lease"; fi

now() { date +%s; }
slot_dir() { if [ "$1" -eq 0 ]; then echo "$L"; else echo "$L.$1"; fi; }
host_slots() { n=$(cat "$L.slots" 2>/dev/null || echo 1); case "$n" in ''|*[!0-9]*) echo 1 ;; *) [ "$n" -ge 1 ] && echo "$n" || echo 1 ;; esac; }
info() { cat "$1/info" 2>/dev/null || echo "(no info)"; }
field() { sed -n "s/^$2=//p" "$1/info" 2>/dev/null; }
write_info() { # dir owner ttl [acquired] slot
  t=$(now)
  printf 'owner=%s\nhost=%s\nacquired=%s\nexpires=%s\nslot=%s\n' "$2" "$(uname -n)" "${4:-$t}" "$((t + $3))" "$5" > "$1/info"
}
# the slot dir this owner holds (any slot index, even above the current N)
held_by() {
  for d in "$L" "$L".[0-9]*; do
    [ -d "$d" ] || continue
    [ "$(field "$d" owner)" = "$1" ] && { echo "$d"; return 0; }
  done
  return 1
}

cmd="${1:-status}"; [ $# -gt 0 ] && shift
slots=$(host_slots)
if [ "${1:-}" = "--slots" ]; then slots="$2"; shift 2; fi
owner="${1:-}"; ttl="${2:-14400}"
case "$cmd" in
  acquire)
    [ -n "$owner" ] || { echo "usage: build-lease acquire [--slots N] <owner> [ttl]" >&2; exit 2; }
    [ -w "$(dirname "$L")" ] || { echo "ERROR: cannot write lease parent $(dirname "$L")" >&2; exit 3; }
    if d=$(held_by "$owner"); then
      write_info "$d" "$owner" "$ttl" "$(field "$d" acquired)" "$(field "$d" slot)"; echo "ALREADY HELD (renewed) $d"; info "$d"; exit 0
    fi
    i=0
    while [ "$i" -lt "$slots" ]; do
      d=$(slot_dir "$i")
      if mkdir "$d" 2>/dev/null; then write_info "$d" "$owner" "$ttl" "" "$i"; echo "ACQUIRED $d (slot $((i + 1))/$slots)"; info "$d"; exit 0; fi
      if [ -f "$d/info" ]; then
        exp=$(field "$d" expires); exp=${exp:-0}
        if [ "$exp" -lt "$(now)" ]; then
          echo "slot $i expired, taking over:"; info "$d"
          rm -rf "$d"
          if mkdir "$d" 2>/dev/null; then write_info "$d" "$owner" "$ttl" "" "$i"; echo "ACQUIRED $d (slot $((i + 1))/$slots)"; exit 0; fi
        fi
      fi
      i=$((i + 1))
    done
    echo "BUSY — all $slots slot(s) held:"; sh "$0" status || true; exit 1 ;;
  renew)
    d=$(held_by "$owner") || { echo "not a holder"; exit 1; }
    write_info "$d" "$owner" "$ttl" "$(field "$d" acquired)" "$(field "$d" slot)"; echo "RENEWED $d"; info "$d" ;;
  release)
    d=$(held_by "$owner") || { echo "no lease held by $owner"; exit 0; }
    rm -rf "$d"; echo "RELEASED $d" ;;
  status)
    n=0; busy=0
    for d in "$L" "$L".[0-9]*; do
      [ -d "$d" ] || continue
      busy=$((busy + 1)); echo "HELD $d: $(field "$d" owner) (expires in $(( $(field "$d" expires) - $(now) ))s)"
    done
    echo "$busy/$slots slot(s) held ($L)"; [ "$busy" -eq 0 ] && echo "FREE ($L)"; true ;;
  slots)
    if [ -n "$owner" ]; then
      case "$owner" in ''|*[!0-9]*) echo "slots must be a positive integer" >&2; exit 2 ;; esac
      echo "$owner" > "$L.slots"; echo "slots=$owner ($L.slots)"
    else echo "slots=$slots ($L.slots)"; fi ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
