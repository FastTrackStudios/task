# Build artifacts
target/
result
result-*
.direnv/
.cache

# Generated Tailwind sheets. The ONE input is apps/task/tailwind.css;
# each app's build.rs compiles it into that app's assets/ (asset!()
# cannot reach outside its crate, so the output is per-app). These were
# committed until 2026-07-27 — ~19,500 lines of build output that had to
# be regenerated by hand and was reliably stale. Don't re-add them.
desktop/assets/tailwind.css
mobile/assets/tailwind.css
web/assets/tailwind.css

# Node / vendored builds
node_modules/
dist/

# Databases / SQLite runtime files
*.db
*.db-journal
*.db-shm
*.db-wal
.dolt/

# Local-only env overrides (`.envrc` itself is tracked — see architect's
# pattern; `.envrc.local` is the per-machine escape hatch)
.envrc.local
.env

# Local-only tool state — beads issue DB, wt worktree config,
# tracey config — these are per-machine, never shared.
.beads/
.config/tracey/
.config/wt.toml

# IDE / agent scratch
.claude/worktrees/
examples/vault/.obsidian/
.claude/

# deploy: staged image artifacts (see deploy/docker/*.Dockerfile)
deploy/docker/web-public/
deploy/docker/ui-lab-dist/

# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk
