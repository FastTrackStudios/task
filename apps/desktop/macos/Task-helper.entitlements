<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for executables nested inside the App Store (TestFlight)
  build of Task, e.g. Contents/MacOS/fts-files-daemon.

  App Store Connect refuses a package in which ANY executable lacks the
  App Sandbox entitlement (error 90296, "App sandbox not enabled. The
  following executables must include the com.apple.security.app-sandbox
  entitlement"). A nested helper signed with no entitlements is exactly
  that, and it is what failed every task-macos run on main.

  app-sandbox plus inherit is Apple's prescribed pair for a helper tool:
  launched by the app, it runs inside the app's sandbox. Nothing else may
  be listed next to inherit. The Developer-ID build (build-dmg.sh) does not
  use this file; it is not sandboxed and signs its helpers with
  Task-devid.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
