filters:
  and:
    - { property: type, equals: meal }

views:
  - name: This week
    type: table
    sort: [{ property: scheduledFor, direction: asc }]
    columns: [scheduledFor, slot, name, status, servings]
  - name: Planned
    type: table
    filter:
      and:
        - { property: status, equals: planned }
    sort: [{ property: scheduledFor, direction: asc }]
    columns: [scheduledFor, slot, name]
  - name: Consumed
    type: table
    filter:
      and:
        - { property: status, equals: consumed }
    sort: [{ property: consumedAt, direction: desc }]
    columns: [scheduledFor, slot, name, consumedAt]
  - name: Skipped
    type: table
    filter:
      and:
        - { property: status, equals: skipped }
    columns: [scheduledFor, slot, name, note]
