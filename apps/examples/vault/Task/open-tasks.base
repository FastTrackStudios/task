filters:
  and:
    - { property: type, equals: synthesis }

views:
  - name: Daily notes
    type: table
    filter:
      and:
        - { property: tags, contains: daily }
    columns: [title, date]
  - name: Meetings
    type: table
    filter:
      and:
        - { property: tags, contains: meeting }
    columns: [title, date]
